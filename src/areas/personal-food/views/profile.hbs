<div class="max-w-4xl mx-auto space-y-6">

  <!-- Breadcrumbs & Header -->
  <div class="flex items-center justify-between">
    <a href="/catalog" class="text-xs font-bold text-slate-500 hover:text-slate-900 flex items-center gap-1">
      &larr; Back to Catalog
    </a>
    <span class="text-xs text-slate-400 font-mono">Feature F16 · Active Health Profile</span>
  </div>

  <!-- Header Banner -->
  <div class="bg-white border border-slate-200 rounded-lg p-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="text-[11px] font-bold uppercase tracking-wider text-emerald-700">Personal Health Configuration</div>
      <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-1">Dietary Preferences & Allergen Profile</h1>
      <p class="text-sm text-slate-600 mt-1 max-w-2xl">
        TrueLabel cross-references your saved preferences against catalog product ingredients in real time to alert you of allergens, dietary mismatches, and nutritional warnings.
      </p>
    </div>
    <div class="flex items-center gap-2 self-start md:self-auto">
      <div class="text-xs font-medium px-3 py-1.5 rounded bg-slate-100 text-slate-700 border border-slate-200">
        Account: <span class="font-bold text-slate-900">{{user.name}}</span>
      </div>
    </div>
  </div>

  <!-- Saved Notification Banner -->
  {{#if saved}}
    <div class="bg-emerald-50 border border-emerald-300 rounded-lg p-4 flex items-center gap-3">
      <div class="w-6 h-6 bg-emerald-600 text-white rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0">✓</div>
      <div>
        <h4 class="text-xs font-bold text-emerald-900 uppercase tracking-tight">Profile Preferences Updated</h4>
        <p class="text-xs text-emerald-800 mt-0.5">Your dietary profile is active. Food catalog items will now automatically reflect your personal allergen and lifestyle conflict alerts.</p>
      </div>
    </div>
  {{/if}}

  <!-- Main Profile Form -->
  <form action="/personal/profile" method="POST" class="space-y-6">

    <!-- SECTION 1: Declared Food Allergies (The Big 9) -->
    <div class="bg-white border border-slate-200 rounded-lg p-6 space-y-4">
      <div class="border-b border-slate-100 pb-3">
        <div class="flex items-center justify-between">
          <h2 class="text-base font-black text-slate-900 tracking-tight">1. Declared Food Allergens & Intolerances</h2>
          <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 bg-rose-100 text-rose-800 rounded">Critical Safety Check</span>
        </div>
        <p class="text-xs text-slate-500 mt-1">
          Select any food allergens you or your family are diagnosed with or avoid. Any product containing these ingredients will trigger an immediate high-contrast alert.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        {{#each standardAllergens}}
          <label class="flex items-center gap-3 p-3 rounded border border-slate-200 hover:border-slate-400 cursor-pointer transition-colors bg-slate-50/50">
            <input
              type="checkbox"
              name="allergies"
              value="{{this}}"
              class="w-4 h-4 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500"
              {{#if (includes ../profile.allergies this)}}checked{{/if}}
            />
            <div class="text-xs">
              <span class="font-bold text-slate-900">{{this}}</span>
              <span class="block text-[11px] text-slate-400">FDA/WHO Major Allergen</span>
            </div>
          </label>
        {{/each}}
      </div>
    </div>

    <!-- SECTION 2: Dietary Lifestyles & Certification Standards -->
    <div class="bg-white border border-slate-200 rounded-lg p-6 space-y-4">
      <div class="border-b border-slate-100 pb-3">
        <div class="flex items-center justify-between">
          <h2 class="text-base font-black text-slate-900 tracking-tight">2. Dietary Lifestyles & Religious Standards</h2>
          <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 bg-slate-100 text-slate-700 rounded">Lifestyle Filter</span>
        </div>
        <p class="text-xs text-slate-500 mt-1">
          Specify dietary patterns you strictly follow. We will flag products that contain conflicting ingredients or lack verified tags.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        {{#each standardDiets}}
          <label class="flex items-center gap-2.5 p-3 rounded border border-slate-200 hover:border-slate-400 cursor-pointer transition-colors bg-slate-50/50">
            <input
              type="checkbox"
              name="dietaryPreferences"
              value="{{this}}"
              class="w-4 h-4 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500"
              {{#if (includes ../profile.dietaryPreferences this)}}checked{{/if}}
            />
            <span class="text-xs font-bold text-slate-800">{{this}}</span>
          </label>
        {{/each}}
      </div>
    </div>

    <!-- SECTION 3: Custom Avoided Ingredients -->
    <div class="bg-white border border-slate-200 rounded-lg p-6 space-y-4">
      <div class="border-b border-slate-100 pb-3">
        <h2 class="text-base font-black text-slate-900 tracking-tight">3. Specific Avoided Ingredients & Additives</h2>
        <p class="text-xs text-slate-500 mt-1">
          Enter any other ingredients, preservatives, or additives you wish to avoid (separated by commas).
        </p>
      </div>

      <div>
        <label for="dislikedIngredients" class="block text-xs font-bold text-slate-700 uppercase tracking-wide">
          Ingredients to Avoid
        </label>
        <input
          type="text"
          id="dislikedIngredients"
          name="dislikedIngredients"
          value="{{#each profile.dislikedIngredients}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}"
          placeholder="e.g. Palm Oil, High Fructose Corn Syrup, Aspartame, MSG, E150d"
          class="mt-1 block w-full px-3 py-2 text-xs border border-slate-300 rounded focus:ring-emerald-500 focus:border-emerald-500"
        />
        <p class="text-[11px] text-slate-400 mt-1">Matches ingredient names case-insensitively.</p>
      </div>
    </div>

    <!-- SECTION 4: Nutritional Target Thresholds -->
    <div class="bg-white border border-slate-200 rounded-lg p-6 space-y-4">
      <div class="border-b border-slate-100 pb-3">
        <h2 class="text-base font-black text-slate-900 tracking-tight">4. Nutritional Target Limits (Per Serving)</h2>
        <p class="text-xs text-slate-500 mt-1">
          Set maximum ceiling thresholds. When a food product exceeds these thresholds per serving, a nutrition advisory notice will be shown.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        <div>
          <label for="calorieGoal" class="block text-xs font-bold text-slate-700">Daily Calorie Target (kcal)</label>
          <input
            type="number"
            id="calorieGoal"
            name="calorieGoal"
            value="{{profile.calorieGoal}}"
            placeholder="e.g. 2000"
            min="500"
            max="8000"
            class="mt-1 block w-full px-3 py-2 text-xs border border-slate-300 rounded font-mono"
          />
        </div>

        <div>
          <label for="maxSugarPerServing" class="block text-xs font-bold text-slate-700">Max Sugar / Serving (g)</label>
          <input
            type="number"
            step="0.5"
            id="maxSugarPerServing"
            name="maxSugarPerServing"
            value="{{profile.maxSugarPerServing}}"
            placeholder="e.g. 10"
            min="0"
            max="100"
            class="mt-1 block w-full px-3 py-2 text-xs border border-slate-300 rounded font-mono"
          />
        </div>

        <div>
          <label for="maxSodiumPerServing" class="block text-xs font-bold text-slate-700">Max Salt/Sodium / Serving (g)</label>
          <input
            type="number"
            step="0.1"
            id="maxSodiumPerServing"
            name="maxSodiumPerServing"
            value="{{profile.maxSodiumPerServing}}"
            placeholder="e.g. 1.2"
            min="0"
            max="20"
            class="mt-1 block w-full px-3 py-2 text-xs border border-slate-300 rounded font-mono"
          />
        </div>

        <div>
          <label for="minProteinPerServing" class="block text-xs font-bold text-slate-700">Min Protein / Serving (g)</label>
          <input
            type="number"
            step="0.5"
            id="minProteinPerServing"
            name="minProteinPerServing"
            value="{{profile.minProteinPerServing}}"
            placeholder="e.g. 15"
            min="0"
            max="100"
            class="mt-1 block w-full px-3 py-2 text-xs border border-slate-300 rounded font-mono"
          />
        </div>
      </div>
    </div>

    <!-- SECTION 5: Body Metrics & Metabolic Foundation (Optional / Mifflin-St Jeor) -->
    <div class="bg-white border border-slate-200 rounded-lg p-6 space-y-4">
      <div class="border-b border-slate-100 pb-3">
        <h2 class="text-base font-black text-slate-900 tracking-tight">5. Body Metrics Foundation (Mifflin-St Jeor Calculation)</h2>
        <p class="text-xs text-slate-500 mt-1">
          Optional metrics used by Area 5 (Diet & Intake Logs) for precise Basal Metabolic Rate (BMR) and Total Daily Energy Expenditure (TDEE).
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
        <div>
          <label for="age" class="block text-xs font-bold text-slate-700">Age (years)</label>
          <input
            type="number"
            id="age"
            name="age"
            value="{{profile.age}}"
            placeholder="e.g. 26"
            min="10"
            max="120"
            class="mt-1 block w-full px-3 py-2 text-xs border border-slate-300 rounded font-mono"
          />
        </div>

        <div>
          <label for="gender" class="block text-xs font-bold text-slate-700">Gender</label>
          <select id="gender" name="gender" class="mt-1 block w-full px-3 py-2 text-xs border border-slate-300 rounded bg-white">
            <option value="">Select</option>
            <option value="male" {{#if (eq profile.gender 'male')}}selected{{/if}}>Male</option>
            <option value="female" {{#if (eq profile.gender 'female')}}selected{{/if}}>Female</option>
            <option value="other" {{#if (eq profile.gender 'other')}}selected{{/if}}>Other</option>
          </select>
        </div>

        <div>
          <label for="heightCm" class="block text-xs font-bold text-slate-700">Height (cm)</label>
          <input
            type="number"
            step="0.5"
            id="heightCm"
            name="heightCm"
            value="{{profile.heightCm}}"
            placeholder="e.g. 175"
            min="60"
            max="250"
            class="mt-1 block w-full px-3 py-2 text-xs border border-slate-300 rounded font-mono"
          />
        </div>

        <div>
          <label for="weightKg" class="block text-xs font-bold text-slate-700">Weight (kg)</label>
          <input
            type="number"
            step="0.5"
            id="weightKg"
            name="weightKg"
            value="{{profile.weightKg}}"
            placeholder="e.g. 70"
            min="20"
            max="300"
            class="mt-1 block w-full px-3 py-2 text-xs border border-slate-300 rounded font-mono"
          />
        </div>

        <div>
          <label for="activityLevel" class="block text-xs font-bold text-slate-700">Activity Level</label>
          <select id="activityLevel" name="activityLevel" class="mt-1 block w-full px-3 py-2 text-xs border border-slate-300 rounded bg-white">
            <option value="">Select</option>
            <option value="sedentary" {{#if (eq profile.activityLevel 'sedentary')}}selected{{/if}}>Sedentary</option>
            <option value="light" {{#if (eq profile.activityLevel 'light')}}selected{{/if}}>Light Active</option>
            <option value="moderate" {{#if (eq profile.activityLevel 'moderate')}}selected{{/if}}>Moderate</option>
            <option value="active" {{#if (eq profile.activityLevel 'active')}}selected{{/if}}>Active</option>
            <option value="very_active" {{#if (eq profile.activityLevel 'very_active')}}selected{{/if}}>Very Active</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Actions Bar -->
    <div class="flex items-center justify-between pt-2">
      <a href="/catalog" class="text-xs font-bold text-slate-600 hover:text-slate-900">Cancel</a>
      <button
        type="submit"
        class="px-6 py-2.5 bg-slate-900 text-white font-bold text-xs rounded hover:bg-slate-800 transition-colors shadow-sm"
      >
        Save Dietary Profile
      </button>
    </div>

  </form>

  <!-- Medical and Allergen Advisory Disclaimer -->
  <div class="p-4 rounded-lg bg-amber-50/70 border border-amber-200 text-xs text-amber-900 space-y-1">
    <div class="font-bold flex items-center gap-1.5">
      <span>⚠️</span>
      <span>Medical & Allergen Safety Advisory</span>
    </div>
    <p class="text-[11px] text-amber-800 leading-relaxed">
      TrueLabel's allergen matching engine operates strictly on manufacturer ingredient declarations and food safety databases. Consumers with severe or life-threatening anaphylactic allergies must always inspect the physical product package and consult a certified medical professional before consumption.
    </p>
  </div>

</div>

