<div class="max-w-md mx-auto my-12 bg-white p-8 border border-slate-200 rounded-lg shadow-sm">
  <div class="mb-6">
    <h1 class="text-2xl font-black text-slate-900 tracking-tight">Sign In</h1>
    <p class="text-sm text-slate-500 mt-1">Access your personalized food preferences or manufacturer console.</p>
  </div>

  {{#if error}}
    <div class="mb-4 p-3 bg-rose-50 border border-rose-200 text-rose-700 text-sm rounded font-medium">
      {{error}}
    </div>
  {{/if}}

  <form action="/auth/login" method="POST" class="space-y-4">
    <div>
      <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Email address</label>
      <input
        type="email"
        id="email"
        name="email"
        value="{{email}}"
        required
        placeholder="consumer@truelabel.demo"
        class="w-full px-3 py-2 border border-slate-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent"
      />
    </div>

    <div>
      <label for="password" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Password</label>
      <input
        type="password"
        id="password"
        name="password"
        required
        placeholder="••••••••"
        class="w-full px-3 py-2 border border-slate-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent"
      />
    </div>

    <button
      type="submit"
      class="w-full py-2.5 px-4 bg-slate-900 text-white font-bold text-sm rounded hover:bg-slate-800 transition-colors"
    >
      Sign In
    </button>
  </form>

  <div class="mt-6 pt-6 border-t border-slate-100 text-center text-xs text-slate-500">
    Don't have an account yet?
    <a href="/auth/register" class="text-emerald-700 font-bold hover:underline">Create an account</a>
  </div>

  <!-- Quick Demo Credentials for Viva / Examiner -->
  <div class="mt-6 p-3 bg-slate-50 rounded border border-slate-200 text-xs">
    <div class="font-bold text-slate-700 mb-1">Quick Demo Accounts (or use header role switcher):</div>
    <div class="space-y-0.5 text-slate-600">
      <div>• <code>consumer@truelabel.demo</code> / <code>password123</code></div>
      <div>• <code>manufacturer@truelabel.demo</code> / <code>password123</code></div>
      <div>• <code>admin@truelabel.demo</code> / <code>password123</code></div>
    </div>
  </div>
</div>

