<div class="max-w-3xl mx-auto my-6 bg-white p-8 border border-slate-200 rounded-lg shadow-sm">
  <div class="mb-6 pb-4 border-b border-slate-200">
    <a href="/catalog" class="text-xs font-bold text-slate-500 hover:text-slate-900">&larr; Back to Catalog</a>
    <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-2">Submit Packaged Food to Catalog</h1>
    <p class="text-sm text-slate-500 mt-0.5">Manufacturers register packaged foods with verified ingredient lists and nutrition declarations (Feature F01).</p>
  </div>

  {{#if error}}
    <div class="mb-6 p-4 rounded bg-rose-50 border border-rose-200 text-rose-700 text-sm font-medium">
      {{error}}
    </div>
  {{/if}}

  <form action="/catalog/manage/create" method="POST" class="space-y-6">
    
    <!-- Section 1: Basic Identity -->
    <div>
      <h2 class="text-sm font-black text-slate-900 uppercase tracking-wider mb-3">1. Basic Identification</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Food Name *</label>
          <input
            type="text"
            name="name"
            required
            placeholder="e.g. Organic Almond Milk Unsweetened"
            class="w-full px-3 py-2 border border-slate-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Brand Name *</label>
          <input
            type="text"
            name="brand"
            required
            placeholder="e.g. PureHarvest"
            class="w-full px-3 py-2 border border-slate-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Category *</label>
          <select
            name="category"
            required
            class="w-full px-3 py-2 border border-slate-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 bg-white"
          >
            {{#each categories}}
              <option value="{{this}}">{{this}}</option>
            {{/each}}
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Barcode (EAN/UPC) *</label>
          <input
            type="text"
            name="barcode"
            required
            placeholder="e.g. 9312345678901"
            class="w-full px-3 py-2 border border-slate-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 font-mono"
          />
          <span class="text-[10px] text-slate-400">Must be unique across the catalog</span>
        </div>
      </div>
    </div>

    <!-- Section 2: Serving Details & Description -->
    <div class="pt-4 border-t border-slate-200">
      <h2 class="text-sm font-black text-slate-900 uppercase tracking-wider mb-3">2. Serving & Description</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Serving Size</label>
          <input
            type="number"
            name="servingSize"
            value="100"
            step="0.1"
            class="w-full px-3 py-2 border border-slate-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Serving Unit</label>
          <select name="servingUnit" class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-white">
            <option value="g">Grams (g)</option>
            <option value="ml">Milliliters (ml)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Dietary Tags (Comma-separated)</label>
          <input
            type="text"
            name="dietaryTags"
            placeholder="Vegan, Gluten-Free, Halal"
            class="w-full px-3 py-2 border border-slate-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
          />
        </div>
      </div>
      <div class="mt-3">
        <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Product Description</label>
        <textarea
          name="description"
          rows="2"
          placeholder="Brief summary of product characteristics..."
          class="w-full px-3 py-2 border border-slate-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
        ></textarea>
      </div>
    </div>

    <button
      type="submit"
      class="w-full py-3 px-6 bg-slate-900 text-white font-bold text-sm rounded hover:bg-slate-800 transition-colors uppercase tracking-wider"
    >
      Register Product to Catalog
    </button>
  </form>
</div>

