<header class="bg-white border-b border-slate-200 sticky top-0 z-50">
  <div class="container mx-auto px-4 max-w-7xl h-16 flex items-center justify-between gap-4">
    
    <!-- Brand Logo -->
    <a href="/catalog" class="flex items-center gap-2 group text-decoration-none">
      <div class="w-9 h-9 bg-slate-900 text-white rounded flex items-center justify-center font-black text-lg tracking-tighter group-hover:bg-emerald-700 transition-colors">
        TL
      </div>
      <div>
        <div class="font-extrabold text-slate-900 tracking-tight leading-none text-lg">TrueLabel</div>
        <div class="text-[10px] text-slate-500 font-semibold uppercase tracking-wider">Food Transparency Platform</div>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600">
      <a href="/catalog" class="hover:text-slate-900 transition-colors">Catalog Discovery</a>
      {{#if (eq user.role "manufacturer")}}
        <a href="/catalog/manage/create" class="hover:text-emerald-700 font-semibold transition-colors">+ Add Product</a>
      {{/if}}
      {{#if (eq user.role "admin")}}
        <a href="/catalog/manage/create" class="hover:text-emerald-700 font-semibold transition-colors">+ Add Product</a>
      {{/if}}
    </nav>

    <!-- Role Switcher & Auth Section -->
    <div class="flex items-center gap-3">
      <!-- Viva Demo Role Switcher -->
      <div class="hidden sm:flex items-center bg-slate-100 rounded p-1 border border-slate-200 text-xs">
        <span class="text-slate-400 font-medium px-2">Role:</span>
        <a href="/auth/switch-role/consumer" class="px-2 py-0.5 rounded font-medium {{#if (eq user.role 'consumer')}}bg-white text-slate-900 shadow-sm{{else}}text-slate-600 hover:text-slate-900{{/if}}">Consumer</a>
        <a href="/auth/switch-role/manufacturer" class="px-2 py-0.5 rounded font-medium {{#if (eq user.role 'manufacturer')}}bg-emerald-600 text-white shadow-sm{{else}}text-slate-600 hover:text-slate-900{{/if}}">Manufacturer</a>
        <a href="/auth/switch-role/admin" class="px-2 py-0.5 rounded font-medium {{#if (eq user.role 'admin')}}bg-slate-900 text-white shadow-sm{{else}}text-slate-600 hover:text-slate-900{{/if}}">Admin</a>
      </div>

      {{#if user}}
        <div class="flex items-center gap-2">
          <div class="text-xs text-right hidden lg:block">
            <div class="font-bold text-slate-900">{{user.name}}</div>
            <div class="text-[11px] text-slate-500 uppercase font-semibold">{{user.role}}</div>
          </div>
          <form action="/auth/logout" method="POST" class="inline">
            <button type="submit" class="text-xs font-semibold px-3 py-1.5 rounded border border-slate-300 text-slate-700 hover:bg-slate-100 transition-colors">
              Sign Out
            </button>
          </form>
        </div>
      {{else}}
        <a href="/auth/login" class="text-xs font-semibold px-3 py-1.5 rounded bg-slate-900 text-white hover:bg-slate-800 transition-colors">
          Sign In
        </a>
      {{/if}}
    </div>
  </div>
</header>

