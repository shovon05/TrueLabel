{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "areas/**/views/**/*",
        "outDir": "dist/areas"
      },
      {
        "include": "shared/views/**/*",
        "outDir": "dist/shared"
      }
    ]
  }
}

