<div class="max-w-md mx-auto my-12 bg-white p-8 border border-slate-200 rounded-lg text-center shadow-sm">
  <div class="w-12 h-12 bg-amber-50 text-amber-700 rounded-full flex items-center justify-center mx-auto mb-4 font-mono font-black text-sm border border-amber-200">
    EAN
  </div>

  <h1 class="text-xl font-black text-slate-900 tracking-tight">Barcode Not Found</h1>
  <p class="text-xs text-slate-500 mt-1">
    No packaged food matches barcode <code class="font-mono font-bold text-slate-800 bg-slate-100 px-1 py-0.5 rounded">{{barcode}}</code> in our catalog.
  </p>

  <div class="mt-6 p-4 rounded bg-slate-50 border border-slate-200 text-left text-xs space-y-2 text-slate-600">
    <div class="font-bold text-slate-800">Request to Add Food:</div>
    <p>Consumers can request this food to be indexed, or verified manufacturers can register this product immediately with official food safety documentation.</p>
  </div>

  <div class="mt-6 flex flex-col gap-2">
    <a href="/catalog" class="py-2.5 px-4 bg-slate-900 text-white font-bold text-xs rounded hover:bg-slate-800">
      Search Other Foods
    </a>
    {{#if (eq user.role "manufacturer")}}
      <a href="/catalog/manage/create" class="py-2.5 px-4 border border-emerald-600 text-emerald-800 font-bold text-xs rounded hover:bg-emerald-50">
        Register Barcode {{barcode}} Now
      </a>
    {{/if}}
  </div>
</div>

