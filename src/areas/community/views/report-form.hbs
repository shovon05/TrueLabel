<div class="max-w-2xl mx-auto space-y-5">
  <a href="/catalog/product/{{product.id}}" class="text-sm text-slate-600 hover:underline">&larr; Back to product</a>
  <form method="POST" action="/community/products/{{product.id}}/report" class="bg-white border border-slate-200 rounded-lg p-6 space-y-5">
    <div>
      <h1 class="text-2xl font-black text-slate-900">Report a problem</h1>
      <p class="text-sm text-slate-600 mt-1">{{product.brand}} — {{product.name}}</p>
      <p class="text-xs text-slate-500 mt-2">Reports are private and sent to the inspection queue. They are not published as reviews.</p>
    </div>
    <label class="block text-sm font-semibold">Problem type
      <select name="category" required class="mt-1 w-full border border-slate-300 rounded p-2">
        <option value="quality">Poor quality / damaged food</option>
        <option value="expired">Expired product</option>
        <option value="label">Incorrect or misleading label</option>
        <option value="allergen">Allergen or ingredient concern</option>
        <option value="other">Other</option>
      </select>
    </label>
    <label class="block text-sm font-semibold">What happened?
      <textarea name="description" rows="5" minlength="20" maxlength="2000" required class="mt-1 w-full border border-slate-300 rounded p-2" placeholder="Describe the problem. Include batch number or date if known."></textarea>
    </label>
    <p class="text-xs text-slate-500">A complaint is not proof of a safety violation. Seek medical assistance for urgent health problems.</p>
    <button type="submit" class="bg-rose-700 text-white font-semibold text-sm rounded px-4 py-2">Submit complaint</button>
  </form>
</div>
